{
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=GramPanchayatElection;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Database": {
    "Provider": "SqlServer",
    "AutoMigrate": true
  },
  "Jwt": {
    "Issuer": "GramPanchayat.Api",
    "Audience": "GramPanchayat.Ui",
    "SigningKey": "CHANGE-ME-in-production-this-demo-key-is-at-least-32-bytes-long",
    "VoterTokenMinutes": 30,
    "AdminTokenMinutes": 480
  },
  "Demo": {
    "Enabled": true,
    "SeedOnStartup": true,
    "InitialPhase": "Polling"
  },
  "Cors": {
    "Origins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
